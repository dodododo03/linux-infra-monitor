# 이 파일을 복사해서 .env를 만들고 값을 채운다:  cp .env.example .env
# .env는 절대 git에 올리지 않는다 (.gitignore에 등록되어 있음)

DISCORD_WEBHOOK_URL=
HOST_NAME=my-ubuntu-server

DB_NAME=infra_monitor
DB_USER=monitor_user
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

COLLECT_INTERVAL=10
ALERT_THRESHOLD=80
ALERT_CONSECUTIVE=3
ALERT_RECOVER_CONSECUTIVE=3
ALERT_REPEAT_MINUTES=30
RETENTION_DAYS=7
